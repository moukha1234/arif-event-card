rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Logos et assets événements — lecture publique, écriture admin authentifié
    match /events/{eventId}/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Photos participants — écriture publique contrôlée, lecture admin
    match /participants/{participantId}/{allPaths=**} {
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read:  if request.auth != null;
    }

    // Affiches générées — Cloud Functions uniquement (pas d'accès direct client)
    match /cards/{participantId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
  }
}
